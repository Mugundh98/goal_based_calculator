APP_NAME=GoalWise API
ENVIRONMENT=development
# postgres:// and postgresql:// URLs (as Neon and Render give them) are accepted too.
DATABASE_URL=postgresql+psycopg://goalwise:goalwise@127.0.0.1:5432/goalwise
DATABASE_CONNECT_TIMEOUT=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regular expression for more allowed origins (e.g. Vercel preview deployments).
CORS_ORIGIN_REGEX=

# Authentication. Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Market data pipeline. SCHEDULER_ENABLED runs the daily jobs inside the API process
# (enable it in ONE process only). RISK_FREE_RATE is a fraction (0.06 = 6% a year).
SCHEDULER_ENABLED=false
DATA_CACHE_DIR=data/cache
RISK_FREE_RATE=0.06

# Monte Carlo runs allowed at the same time (~180 MB each at most). Use 1 on a 512 MB server.
SIMULATION_CONCURRENCY=4

# Conversational assistant (Phase 10): a Google AI Studio key. Leave empty to switch it off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHAT_MESSAGES_PER_HOUR=30
