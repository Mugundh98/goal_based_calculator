APP_NAME=GoalWise API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://goalwise:goalwise@127.0.0.1:5432/goalwise
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication. Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Market data pipeline. SCHEDULER_ENABLED runs the daily jobs inside the API process
# (enable it in ONE process only). RISK_FREE_RATE is a fraction (0.06 = 6% a year).
SCHEDULER_ENABLED=false
DATA_CACHE_DIR=data/cache
RISK_FREE_RATE=0.06
